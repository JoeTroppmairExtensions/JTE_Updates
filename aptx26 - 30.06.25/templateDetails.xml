<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE install PUBLIC "-//Joomla! 2.5//DTD template 1.0//EN" "https://www.joomla.org/xml/dtd/2.5/template-install.dtd">
<extension version="3.1" type="template" client="site" method="upgrade">
    <name>aptx26</name>
    <version>1.0</version>
    <creationDate>01.06.2025</creationDate>
    <author>Joe Troppmair</author>
	<authorEmail>joe@troppmair.com</authorEmail>
	<description>TPL_APTX26_XML_DESCRIPTION</description>
    <files>
		<folder>css</folder>
		<folder>html</folder>
		<folder>images</folder>
		<folder>includes</folder>
		<folder>js</folder>
		<filename>component.php</filename>
		<filename>error.php</filename>
		<filename>favicon.ico</filename>
		<filename>index.html</filename>
		<filename>index.php</filename>
        <filename>info.txt</filename>
		<filename>templateDetails.xml</filename>
		<filename>template_thumbnail.png</filename>
		<filename>template_preview.png</filename>
    </files>
    <positions>
		<position>startslider</position>
		<position>menu</position>
		<position>offcanvas</position>
		<position>footermenu</position>
		<position>language</position>
		<position>left</position>
		<position>right</position>
		<position>footer</position>
		<position>debug</position>
		<position>flexheadertop</position>
		<position>flexheadercontent</position>
		<position>showcase</position>
		<position>blind</position>
    </positions>
	<languages folder="language">
		<language tag="en-GB">en-GB/tpl_aptx26.ini</language>
		<language tag="en-GB">en-GB/tpl_aptx26.sys.ini</language>
	</languages>
	<updateservers>
		<server type="extension" name="JoeTroppmairExtensions Updates" priority="1">http://jte.troppmair.com/updates/updates.xml</server>
	</updateservers>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="fluidgrid" type="radio" class="btn-group" default="" label="TPL_APTX26_FLUID_LABEL" description="TPL_APTX26_FLUID_DESC">
					<option value="-fluid">JYES</option>
					<option value="">JNO</option>
				</field>
				<field name="leftColumnWidth" type="list" default="3" label="TPL_APTX26_LEFTCOLWIDTH_LABEL" description="TPL_APTX26_LEFTCOLWIDTH_DESC">
					<option value="2">2</option>
					<option value="3">3</option>
					<option value="4">4</option>
					<option value="5">5</option>
				</field>
				<field name="rightColumnWidth" type="list" default="3" label="TPL_APTX26_RIGHTCOLWIDTH_LABEL" description="TPL_APTX26_RIGHTCOLWIDTH_DESC">
					<option value="2">2</option>
					<option value="3">3</option>
					<option value="4">4</option>
					<option value="5">5</option>
				</field>
				<field name="footercolgrid" type="list" default="-4" label="TPL_APTX26_FOOTERCOLWIDTH_LABEL" description="TPL_APTX26_FOOTERCOLWIDTH_DESC">
					<option value="3">3</option>
					<option value="4">4</option>
					<option value="5">5</option>
					<option value="6">6</option>
					<option value="7">7</option>
					<option value="8">8</option>
					<option value="9">9</option>
					<option value="10">10</option>
				</field>
			</fieldset>
			<fieldset name="BS5Framework">
				<field name="bootstrapframework" type="radio" class="btn-group" default="1" label="TPL_APTX26_BSFRAMEWORK_LABEL" description="TPL_APTX26_BSFRAMEWORK_DESC">
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
